# Server
PORT=3001
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=leave_management

# Auth — REQUIRED. The server refuses to start without a unique JWT_SECRET
# of at least 16 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRY=30m
BCRYPT_ROUNDS=10

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Email (optional). Without SMTP_USER the app logs instead of sending.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PeopleXM Leave Management <noreply@example.com>

# Used for links inside outgoing emails
APP_URL=http://localhost:5173

# Shown in email signatures
COMPANY_NAME=Your Company Name
